pipeline {
    agent any

    tools {
        // Make sure these match your Global Tool Configuration!
        jdk 'JDK11'
        maven 'Maven3'
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Code already checked out by Jenkins from GitHub.'
            }
        }

        // We must tell Jenkins to look inside the 'Framework' folder
        // because that's where you pushed your pom.xml
        stage('Verify Environment') {
            steps {
                dir('Framework') {
                    echo 'Checking Java and Maven versions...'
                    bat 'java -version'
                    bat 'mvn -version'
                }
            }
        }

        stage('Build') {
            steps {
                dir('Framework') {
                    echo 'Compiling the project...'
                    bat 'mvn -B -DskipTests clean compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir('Framework') {
                    echo 'Running TestNG tests...'
                    bat 'mvn -B test'
                }
            }
        }
    }

    post {
        always {
            echo 'Collecting test reports...'
            // Since the reports are inside Framework/, we adjust the path
            junit testResults: '**/Framework/target/surefire-reports/*.xml', allowEmptyResults: true
            archiveArtifacts artifacts: '**/Framework/test-output/**', allowEmptyArchive: true
        }
        success {
            echo '✅ Pipeline finished successfully.'
        }
        failure {
            echo '❌ Pipeline failed. Check the console output above.'
        }
    }
}